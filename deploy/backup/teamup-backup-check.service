[Unit]
Description=Check TeamUp database backup freshness and integrity

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=%h/.config/teamup-backup/receiver.env
ExecStart=/usr/bin/python3 %h/.local/lib/teamup-backup/pull_backup.py check --root ${TEAMUP_BACKUP_ROOT} --max-age-hours 2 --metadata-only $TEAMUP_BACKUP_SOURCES
TimeoutStartSec=5min
