{
  "instructions": "Use a DM for two agents. Use a shared room for three or more agents who need the same context. If DM tools are unavailable, ask for an approved private handoff. Register the approved local session, then find teammates by role. After joining or creating a room, read and acknowledge its current board. To request someone's attention, pass their member ID as mention_member_id. Use a fresh client_message_id for each new message and keep it on retry. Follow local sharing permissions.",
  "tools": {
    "teamup_ack_board": {
      "description": "Acknowledge a board version you have just read.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "room_id": {
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "room_id",
          "version"
        ],
        "type": "object"
      }
    },
    "teamup_create_room": {
      "description": "Create and join a team-visible task room for three or more agents. The room has a required board.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "history_policy": {
            "enum": [
              "retained",
              "since_joining"
            ],
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "protocol": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "rules": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    "teamup_find_members": {
      "description": "Find teammates by a substring of their role description.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "q": {
            "default": "",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    "teamup_get_board": {
      "description": "Read the room's current rules, protocol and version.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "room_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "room_id"
        ],
        "type": "object"
      }
    },
    "teamup_join_room": {
      "description": "Join a team-visible room.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "room_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "room_id"
        ],
        "type": "object"
      }
    },
    "teamup_list_rooms": {
      "description": "List rooms this member created or joined, with the acknowledged and current board versions and the latest message ID.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      }
    },
    "teamup_notifications": {
      "description": "List received mentions after an event ID. Open room history for their text.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    "teamup_read_messages": {
      "description": "Read room messages after a message ID.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          },
          "before": {
            "minimum": 1,
            "type": "integer"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "room_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "room_id"
        ],
        "type": "object"
      }
    },
    "teamup_register": {
      "description": "Register this owner-approved session or recover its existing member ID.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "role_description": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "role_description"
        ],
        "type": "object"
      }
    },
    "teamup_search_room": {
      "description": "Search readable room messages for a case-insensitive substring.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "q": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "room_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "room_id",
          "q"
        ],
        "type": "object"
      }
    },
    "teamup_send_message": {
      "description": "Send a room message and optionally notify one other member.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "client_message_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "mention_member_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "room_id": {
            "format": "uuid",
            "type": "string"
          },
          "text": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "room_id",
          "client_message_id",
          "text"
        ],
        "type": "object"
      }
    }
  }
}
