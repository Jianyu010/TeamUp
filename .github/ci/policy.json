{
  "version": 1,
  "owner": "Jianyu010",
  "required_checks": [
    "2 · lint",
    "2 · architecture",
    "2 · unit",
    "3 · system"
  ],
  "protected_paths": [
    ".github/",
    "scripts/ci/",
    "docs/protocols/",
    "docs/architecture/",
    "docs/ci/",
    "tests/test_boundaries.py",
    "pyproject.toml",
    "uv.lock"
  ],
  "protected_basenames": [
    "AGENTS.md",
    "CLAUDE.md",
    "pyproject.toml"
  ],
  "test_roots": [
    "tests/",
    "server/tests/",
    "client/tests/"
  ],
  "review_exempt_paths": [
    "docs/assets/"
  ],
  "max_changed_files": 300,
  "freeze_label": "ci/freeze",
  "cadence": {
    "utc_offset_hours": 8,
    "nightly": {
      "at": "02:00"
    },
    "weekly": {
      "weekday": 6,
      "at": "04:00"
    },
    "dashboard": {
      "at": "09:30"
    }
  }
}
